PORT=3001
# Render automatically trusts its nearest proxy. For other reverse-proxy
# deployments set the exact hop count (Docker Compose sets this to 1).
# TRUST_PROXY_HOPS=1
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173/
# Use MongoDB Atlas (replica set transactions required).
MONGODB_URI=
# Alternatively use the separate Atlas fields (URI takes precedence):
MONGODB_HOST=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=loomiq
# Offline development only:
STORAGE_DRIVER=
# OFFER_DB_PATH=/var/lib/loomiq/offers.json
ADMIN_API_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Recommended for Render Free: HTTPS email delivery (port 443).
MAIL_PROVIDER=resend
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. LoomIQ <noreply@loomiq.site>.
EMAIL_FROM=
# Optional alternative for hosts permitting SMTP: MAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SALES_EMAIL=devvsharma124@gmail.com
# ERP backend origin, not the ERP frontend/login URL; do not append /api.
# The integration client appends /api/integrations/marketing/demo-requests.
ERP_API_URL=http://localhost:5000
ERP_MARKETING_INTEGRATION_TOKEN=
# The public HTTPS ERP login page. This is recorded on the customer's account
# after a paid demo conversion.
ERP_LOGIN_URL=http://localhost:5173/login
# Retry delay for a temporarily unavailable ERP API (30 seconds by default).
ERP_CONVERSION_RETRY_INTERVAL_MS=30000
# Receives an alert whenever a user creates an account. Falls back to SALES_EMAIL.
ACCOUNT_NOTIFICATION_EMAIL=
INVOICE_BUSINESS_NAME=
INVOICE_BUSINESS_ADDRESS=
# Non-GST commercial invoices: supplier GSTIN is not displayed.
INVOICE_PHONE=
INVOICE_EMAIL=devvsharma124@gmail.com
INVOICE_WEBSITE=
INVOICE_PAN=
INVOICE_CIN=
INVOICE_SAC=
INVOICE_BANK_NAME=
INVOICE_ACCOUNT_HOLDER=
INVOICE_ACCOUNT_NUMBER=
INVOICE_IFSC=
INVOICE_UPI=
# Staging only; omit for live production.
ALLOW_TEST_PAYMENTS=false
