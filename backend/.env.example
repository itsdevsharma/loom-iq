PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Set to file for local development when MongoDB Atlas is unavailable.
# Production should use MongoDB and leave this unset.
STORAGE_DRIVER=

# Email configuration (optional - for demo request notifications)
# Uses Brevo (Sendinblue) by default. For Gmail, use smtp.gmail.com with port 587.
EMAIL_API_KEY=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_FROM="LoomIQ Website" <noreply@loomiq.com>
SALES_EMAIL=

# Razorpay payment integration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Offer enrollment starts at signup; ordinary landing links are supported.
# Configure payment.captured at /api/purchase/webhook in Razorpay.
RAZORPAY_WEBHOOK_SECRET=
# Optional persistent store path. Run one API process with durable storage.
# OFFER_DB_PATH=/var/lib/loomiq/offers.json

# MongoDB Atlas: paste only the hostname from Connect > Drivers.
MONGODB_HOST=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=loomiq
# Alternatively supply the full URI (takes precedence over separate fields).
MONGODB_URI=

# Required only for operator access to GET /api/demo-requests (Bearer token).
ADMIN_API_TOKEN=

# Seller details printed on membership invoices (not a GST tax-invoice engine).
INVOICE_BUSINESS_NAME=LoomIQ
INVOICE_BUSINESS_ADDRESS=
INVOICE_GSTIN=
