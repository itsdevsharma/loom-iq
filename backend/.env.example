PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173/
# Use MongoDB Atlas (replica set transactions required).
MONGODB_URI=
# Alternatively use the separate Atlas fields (URI takes precedence):
MONGODB_HOST=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=loomiq
# Offline development only:
STORAGE_DRIVER=
# OFFER_DB_PATH=/var/lib/loomiq/offers.json
ADMIN_API_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SALES_EMAIL=
# Receives an alert whenever a user creates an account. Falls back to SALES_EMAIL.
ACCOUNT_NOTIFICATION_EMAIL=
INVOICE_BUSINESS_NAME=
INVOICE_BUSINESS_ADDRESS=
# Non-GST commercial invoices: supplier GSTIN is not displayed.
INVOICE_PHONE=
INVOICE_EMAIL=support@loomiq.com
INVOICE_WEBSITE=
INVOICE_PAN=
INVOICE_CIN=
INVOICE_SAC=
INVOICE_BANK_NAME=
INVOICE_ACCOUNT_HOLDER=
INVOICE_ACCOUNT_NUMBER=
INVOICE_IFSC=
INVOICE_UPI=
# Staging only; omit for live production.
ALLOW_TEST_PAYMENTS=false
