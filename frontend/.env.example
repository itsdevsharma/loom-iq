# Leave blank for the Vite development proxy. Set this to the deployed API origin in production.
PUBLIC_API_URL=
PUBLIC_SITE_URL=https://loomiq.site
PUBLIC_BASE_PATH=/
# Set to true after configuring the Auth0 variables on the backend.
PUBLIC_AUTH0_ENABLED=false
# GA4 web stream measurement ID (G-...). Enabled in production builds only.
PUBLIC_GOOGLE_ANALYTICS_ID=

# Optional: numeric Meta Pixel ID; loaded only after analytics consent.
PUBLIC_META_PIXEL_ID=
