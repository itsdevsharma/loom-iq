{
  "installCommand": "npm ci && npm --prefix ../admin ci",
  "buildCommand": "npm run build:with-admin",
  "outputDirectory": "dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://loom-iq.onrender.com/api/$1"
    },
    {
      "src": "/admin(?:/.*)?",
      "dest": "/admin/index.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
